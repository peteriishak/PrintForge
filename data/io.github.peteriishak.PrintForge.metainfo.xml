<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.peteriishak.PrintForge</id>
  <name>PrintForge</name>
  <summary>Modern printing application for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.peteriishak">
    <name>Peter Habib</name>
  </developer>

  <description>
    <p>
      PrintForge is a modern, polished printing application for Fedora Linux
      that makes printing files and images easy while giving full control
      over print settings.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Drag and drop files for quick printing</li>
      <li>Live preview showing exactly how your document will print</li>
      <li>Full control: paper size, margins, scaling, position, quality</li>
      <li>CUPS integration with automatic printer discovery</li>
      <li>Support for images (PNG, JPEG, WebP, BMP, TIFF, SVG), PDF, PostScript, office documents, text, Markdown and source code</li>
      <li>Save and load print configuration presets</li>
      <li>Command-line interface for scripted printing</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.peteriishak.PrintForge.desktop</launchable>

  <url type="homepage">https://github.com/peteriishak/PrintForge</url>
  <url type="bugtracker">https://github.com/peteriishak/PrintForge/issues</url>
  <url type="vcs-browser">https://github.com/peteriishak/PrintForge</url>

  <screenshots>
    <screenshot type="default">
      <caption>Print queue with live preview and print settings</caption>
      <image>https://raw.githubusercontent.com/peteriishak/PrintForge/main/docs/screenshots/main-window.png</image>
    </screenshot>
    <screenshot>
      <caption>Image layout preview</caption>
      <image>https://raw.githubusercontent.com/peteriishak/PrintForge/main/docs/screenshots/image-preview.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#62a0ea</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <releases>
    <release version="1.0.0" date="2026-11-27">
      <description>
        <p>Initial release of PrintForge.</p>
      </description>
    </release>
  </releases>
</component>
